# ============================================
# UDSM Information Dissemination Platform
# Copy this file to .env.local and fill in values
# ============================================

# Database (PostgreSQL / Supabase). Use Dashboard → Connection string (pool URI is fine for the app + Drizzle Kit).
DATABASE_URL=postgresql://user:password@localhost:5432/udsm_platform

# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Resend (Email Service)
RESEND_API_KEY=

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
OTP_EXPIRY_MINUTES=10

# Admin email for seed (optional; default admin@udsminfo.com)
ADMIN_EMAIL=admin@example.com
# Any one of these unlocks user seeding: admin + demo accounts share this password for bcrypt in one run
ADMIN_PASSWORD=
SEED_PASSWORD=
SEED_DEMO_PASSWORD=

# CORS: comma-separated origins that may call /api/* (browser preflight checks this).
# Production must include the exact origin hosting Swagger / frontend (scheme + host), e.g. https://udsminfo.com
# NEXT_PUBLIC_APP_URL is merged automatically into allowed origins when set.
ALLOWED_ORIGINS=http://localhost:3000

# Supabase Storage
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# File Upload
MAX_FILE_SIZE_MB=10

# Firebase Cloud Messaging (backend push via firebase-admin)
# From Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=udsm-connect
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cron secret for /api/cron/* (Vercel Cron or external scheduler sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
