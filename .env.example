# ============================================
# UDSM Information Dissemination Platform
# Copy this file to .env.local and fill in values
# ============================================

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/udsm_platform

# Drizzle CLI (push / migrate / studio) — optional override for Supabase:
# Transaction pooler (port 6543) works for serverless pools but Drizzle introspection is very slow → looks "hanging".
# In Supabase: Database → Connection string → use "Direct connection" (port 5432) below.
DRIZZLE_DATABASE_URL=
# Alias some Supabase tooling uses:
# DIRECT_URL=
# If push still fails silently, try: pnpm db:push:verbose (and ensure the direct URI host is db.<project>.supabase.co, not pooler.supabase.com)

# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Resend (Email Service)
RESEND_API_KEY=

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
OTP_EXPIRY_MINUTES=10

# Admin email for seed (optional; default admin@udsminfo.com)
ADMIN_EMAIL=admin@example.com
# Any one of these unlocks user seeding: admin + demo accounts share this password for bcrypt in one run
ADMIN_PASSWORD=
SEED_PASSWORD=
SEED_DEMO_PASSWORD=

# CORS (comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:3000

# Supabase Storage
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# File Upload
MAX_FILE_SIZE_MB=10
